# ObsiFlow environment template. Copy to `.env` and edit locally.
# NEVER commit `.env` or real credentials. Values below are development defaults.

# ---- Application -----------------------------------------------------------
OBSIFLOW_ENVIRONMENT=development
OBSIFLOW_LOG_LEVEL=INFO
OBSIFLOW_PIPELINE_DAG_ID=dq_etl_pipeline
OBSIFLOW_METRICS_PORT=9101

# ---- PostgreSQL (application + local Airflow metadata) ---------------------
POSTGRES_USER=obsiflow
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=obsiflow
POSTGRES_PORT=5432

OBSIFLOW_POSTGRES_HOST=localhost
OBSIFLOW_POSTGRES_PORT=5432
OBSIFLOW_POSTGRES_DB=obsiflow
OBSIFLOW_POSTGRES_USER=obsiflow
OBSIFLOW_POSTGRES_PASSWORD=change-me-local-only

# ---- Airflow (local Docker Compose only) -----------------------------------
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change-me-local-only
AIRFLOW_ADMIN_EMAIL=admin@obsiflow.local
AIRFLOW_WEBSERVER_PORT=8080
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# AIRFLOW_FERNET_KEY=
# AIRFLOW_SECRET_KEY=

# ---- Observability ---------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local-only
